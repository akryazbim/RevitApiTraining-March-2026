    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\n\nclr.AddReference('RevitAPI')\nfrom Autodesk.Revit.DB import *\n\nclr.AddReference(\"RevitServices\")\nimport RevitServices\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\nview = doc.ActiveView\n\n# Get all walls in the active view\nwalls = FilteredElementCollector(doc, view.Id).OfCategory(BuiltInCategory.OST_Walls).WhereElementIsNotElementType().ToElements()\n\n# Define the color red (RGB 255, 0, 0)\ncolor_red = Color(255, 0, 0)\n\nTransactionManager.Instance.EnsureInTransaction(doc)\n\n# Create OverrideGraphicSettings for projection lines\noverride_settings = OverrideGraphicSettings()\noverride_settings.SetProjectionLineColor(color_red)\n\n# Create separate settings for surface if needed, or clear them if not wanted\n# For this request, we only want to change the projection line color.\n# If you also want to change the surface color to red, you would do:\n# override_settings.SetSurfaceForegroundPatternColor(color_red)\n\nfor wall in walls:\n    # Apply the override settings to the wall in the current view\n    view.SetElementOverrides(wall.Id, override_settings)\n\nTransactionManager.Instance.TransactionTaskDone()",
