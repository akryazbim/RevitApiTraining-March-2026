  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# Revit API\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference('RevitServices')\r\n\r\nfrom Autodesk.Revit.DB import *\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\n# Document\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Inputs from Dynamo\r\nelements = UnwrapElement(IN[0])\r\nview = UnwrapElement(IN[1])\r\n\r\n# -----------------------------\r\n# CHANGE THIS BASED ON ELEMENT\r\n# -----------------------------\r\ntagCategory = BuiltInCategory.OST_WallTags   # Change if needed\r\n\r\n# -----------------------------\r\n# GET TAG FAMILY TYPE\r\n# -----------------------------\r\ntagSymbols = FilteredElementCollector(doc)\\\r\n    .OfClass(FamilySymbol)\\\r\n    .OfCategory(tagCategory)\\\r\n    .ToElements()\r\n    \r\n\r\nif not tagSymbols:\r\n    OUT = \"❌ No tag family loaded for this category\"\r\nelse:\r\n    tagType = tagSymbols[0]\r\n\r\n    # Activate tag type if needed\r\n    if not tagType.IsActive:\r\n        TransactionManager.Instance.EnsureInTransaction(doc)\r\n        tagType.Activate()\r\n        TransactionManager.Instance.TransactionTaskDone()\r\n\r\n    # -----------------------------\r\n    # CREATE TAGS\r\n    # -----------------------------\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n    count = 0\r\n    failed = 0\r\n\r\n    for elem in elements:\r\n        try:\r\n            if elem is None:\r\n                continue\r\n\r\n            loc = elem.Location\r\n\r\n            # Get placement point\r\n            if isinstance(loc, LocationCurve):\r\n                point = loc.Curve.Evaluate(0.5, True)\r\n            elif isinstance(loc, LocationPoint):\r\n                point = loc.Point\r\n            else:\r\n                failed += 1\r\n                continue\r\n\r\n            # Create reference\r\n            refer = Reference(elem)\r\n            if refer is None:\r\n                failed += 1\r\n                continue\r\n\r\n            # Create tag\r\n            tag = IndependentTag.Create(\r\n                doc,\r\n                tagType.Id,   # IMPORTANT FIX\r\n                view.Id,\r\n                refer,\r\n                False,\r\n                TagOrientation.Horizontal,\r\n                point\r\n            )\r\n\r\n            if tag:\r\n                count += 1\r\n            else:\r\n                failed += 1\r\n\r\n        except:\r\n            failed += 1\r\n\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n\r\n    OUT = \"✅ Tags created: {} | ❌ Failed: {}\".format(count, failed)\"\"\"",
      "Engine": "CPython3",
      "VariableInputPorts": true,
