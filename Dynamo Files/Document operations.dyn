      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nimport sys\r\nsys.path.append('C:\\Program Files (x86)\\IronPython 2.7\\Lib')\r\n\r\nimport System\r\nfrom System.Collections.Generic import *\r\n\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager \r\nfrom RevitServices.Transactions import TransactionManager \r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitAPIUI\")\r\n\r\nimport Autodesk \r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.UI import *\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication \r\napp = uiapp.Application \r\nuidoc = uiapp.ActiveUIDocument\r\n\r\ndef tolist(obj1):\r\n\tif isinstance(obj1,(list, tuple, set)): return obj1\r\n\telse: return [obj1]\r\n\r\n#Preparing input from dynamo to revit\r\nelement = UnwrapElement(IN[0])\r\n\r\n#Do some action in a Transaction\r\n\"\"\"\r\nRvtlinks = FilteredElementCollector(doc).OfClass(RevitLinkInstance).ToElements()\r\nfor Rvtlink in Rvtlinks:\r\n    if \"Architectural\" in Rvtlink.Name:\r\n        linkfile = Rvtlink\r\n        break\r\n        \r\nlinkDoc = linkfile.GetLinkDocument()\r\n\"\"\"\r\n\r\npath = r\"C:\\Users\\Akryazz\\OneDrive\\Documents\\My Files\\Revit Api Training\\Python Revit API Training\\Revit Models\\2025\\MEP Model.rvt\"\r\n\r\nworkSharedPath = r\"C:\\Users\\Akryazz\\OneDrive\\Documents\\My Files\\Revit Api Training\\Python Revit API Training\\Revit Models\\2025\\Elec-Workshared.rvt\"\r\n\r\nmodelPath = FilePath(workSharedPath)\r\n\r\nopt = OpenOptions()\r\nopt.Audit = False\r\nopt.DetachFromCentralOption = DetachFromCentralOption.DoNotDetach\r\n\r\nwsDoc = app.OpenDocumentFile(modelPath, opt) \r\n\r\ncts = FilteredElementCollector(wsDoc).OfCategory(BuiltInCategory.OST_CableTray).WhereElementIsNotElementType().ToElements()\r\n\r\nTransactionManager.Instance.EnsureInTransaction(wsDoc)\r\nfor ct in cts:\r\n    ct.LookupParameter(\"Comments\").Set(\"Test my code\")\r\n\r\nTransactionManager.Instance.ForceCloseTransaction()\r\n\r\ntOpt = TransactWithCentralOptions()\r\nsOpt = SynchronizeWithCentralOptions()\r\n\r\nwsDoc.SynchronizeWithCentral(tOpt, sOpt)\r\nwsDoc.Close()\r\n\r\n\r\n\"\"\"\r\nmepDoc = app.OpenDocumentFile(path)\r\n\r\nducts = FilteredElementCollector(mepDoc).OfCategory(BuiltInCategory.OST_DuctCurves).WhereElementIsNotElementType().ToElements()\r\n\r\n\r\n\r\nductList = []\r\nfor duct in ducts:\r\n    duct.LookupParameter(\"Comments\").Set(\"21435213\")\r\n    comm = duct.LookupParameter(\"Comments\").AsString()\r\n    ductList.append(comm)\r\n\r\n\r\nTransactionManager.Instance.ForceCloseTransaction()\r\n\r\nmepDoc.Save()\r\nmepDoc.Close()\r\n\"\"\"\r\nOUT = ct",
