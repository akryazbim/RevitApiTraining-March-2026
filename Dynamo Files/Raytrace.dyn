    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nimport sys\r\nsys.path.append('C:\\Program Files (x86)\\IronPython 2.7\\Lib')\r\n\r\nimport System\r\nfrom System.Collections.Generic import *\r\n\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager \r\nfrom RevitServices.Transactions import TransactionManager \r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitAPIUI\")\r\n\r\nimport Autodesk \r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.UI import *\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication \r\napp = uiapp.Application \r\nuidoc = uiapp.ActiveUIDocument\r\n\r\ndef tolist(obj1):\r\n\tif isinstance(obj1,(list, tuple, set)): return obj1\r\n\telse: return [obj1]\r\n\r\n#Preparing input from dynamo to revit\r\nelement = UnwrapElement(IN[0])\r\n\r\n#Do some action in a Transaction\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n\r\nauthor = \"Dnyan\"\r\n\r\n# input from Dynamo\r\ninput_elements = FilteredElementCollector(doc).OfClass(RevitLinkInstance).ToElements()\r\n\r\n# Output List\r\nelement_names    = []\r\nelement_ids      = []\r\nelement_cats     = []\r\nlinked_doc_names = []\r\n\r\n\r\nfor elem in input_elements:\r\n    try:\r\n        unwrapped = UnwrapElement(elem)\r\n\r\n        if unwrapped is None:\r\n            continue\r\n\r\n# Link Instance \r\n        if isinstance(unwrapped, RevitLinkInstance):\r\n\r\n            linked_doc = unwrapped.GetLinkDocument()\r\n            if linked_doc is None:\r\n                continue\r\n\r\n        # Collect all elements from linked doc\r\n            elements = FilteredElementCollector(linked_doc)\\\r\n                        .WhereElementIsNotElementType()\\\r\n                        .ToElements()\r\n\r\n            for linked_element in elements:\r\n                try:\r\n                    type_id   = linked_element.GetTypeId()\r\n                    elem_type = linked_doc.GetElement(type_id)\r\n                    name = elem_type.Name if elem_type else linked_element.Name\r\n                except:\r\n                    name = linked_element.Name if hasattr(linked_element, 'Name') else \"Unnamed\"\r\n\r\n                cat = linked_element.Category.Name if linked_element.Category else \"No Category\"\r\n\r\n                element_names.append(name)\r\n                element_ids.append(linked_element.Id.IntegerValue)\r\n                element_cats.append(cat)\r\n                linked_doc_names.append(linked_doc.Title)\r\n        else:\r\n            try:\r\n                type_id   = unwrapped.GetTypeId()\r\n                elem_type = doc.GetElement(type_id)\r\n                name = elem_type.Name if elem_type else unwrapped.Name\r\n            except:\r\n                name = unwrapped.Name if hasattr(unwrapped, 'Name') else \"Unnamed\"\r\n\r\n            cat = unwrapped.Category.Name if unwrapped.Category else \"No Category\"\r\n\r\n            element_names.append(name)\r\n            element_ids.append(unwrapped.Id.IntegerValue)\r\n            element_cats.append(cat)\r\n            linked_doc_names.append(doc.Title)\r\n\r\n    except:\r\n        pass\r\n\r\n# Output\r\nOUT = element_names, element_ids, element_cats, linked_doc_names, author\r\n",
