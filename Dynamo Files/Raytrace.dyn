      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nimport sys\r\nsys.path.append('C:\\Program Files (x86)\\IronPython 2.7\\Lib')\r\n\r\nimport System\r\nfrom System.Collections.Generic import *\r\n\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager \r\nfrom RevitServices.Transactions import TransactionManager \r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitAPIUI\")\r\n\r\nimport Autodesk \r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.UI import *\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication \r\napp = uiapp.Application \r\nuidoc = uiapp.ActiveUIDocument\r\n\r\ndef tolist(obj1):\r\n\tif isinstance(obj1,(list, tuple, set)): return obj1\r\n\telse: return [obj1]\r\n\r\n#Preparing input from dynamo to revit\r\nelement = UnwrapElement(IN[0])\r\n\r\n#Do some action in a Transaction\r\n\"\"\"\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nTaskDialog.Show(\"Prompt\",\"Now select Revit Links only from the current view\")\r\n\r\neles = uidoc.Selection.PickObjects(ObjectType.Element)\r\n#selectrefs = uidoc.Selection.PickObjects(ObjectType.Element)\r\n#ele = [doc.GetElement(i.ElementId) for i in selectrefs]\r\n#lnkname = lnkele.Name\r\n\r\n\r\n#ids = List[ElementId]()\r\nlnkname = []\r\nductss = []\r\nfor lnkele in eles:\r\n    linkInstance = doc.GetElement(lnkele)\r\n    if isinstance(linkInstance, RevitLinkInstance):\r\n        if linkInstance:\r\n            linkdoc = linkInstance.GetLinkDocument()\r\n            ducts = FilteredElementCollector(linkdoc).OfCategory(BuiltInCategory.OST_DuctCurves).WhereElementIsNotElementType().ToElements()\r\n            ductss.append(ducts)\r\n            #for duct in ducts:\r\n                #id = duct.Id\r\n                #ids.Add(id)\r\n            lnknme = linkdoc.Title\r\n            lnkname.append(lnknme)\r\n    else:\r\n        lnkname = \"Selected element is not a Revit Link Instance\"\r\n\r\n\r\n#uidoc.Selection.SetElementIds(ids)\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n\"\"\"\r\nviews = FilteredElementCollector(doc).OfClass(View3D)\r\n\r\nview = []\r\nfor v in views:\r\n    if v.Name == \"Sundar\":\r\n        viewn = v\r\n        view.append(viewn)\r\n        filename = v.Name+\".nwc\"\r\n        break\r\n\"\"\"\r\nviewcls = List[ElementId]()\r\nfor vi in view:\r\n    viewcls.Add(vi.Id)\r\n\"\"\"\r\npath = r\"C:\\Users\\Asus\\Downloads\\DYNAMO TRAINING\\LEVEL 02 - PYTHON\\Export\\NWC\"\r\n\r\nnwcOpt = NavisworksExportOptions()\r\n\r\nnwcOpt.ExportLinks = True\r\nnwcOpt.ExportRoomAsAttribute = True\r\nnwcOpt.ExportRoomGeometry = True\r\nnwcOpt.ConvertElementProperties = True\r\nnwcOpt.ConvertLights = True\r\nnwcOpt.ConvertLinkedCADFormats = False\r\nnwcOpt.DivideFileIntoLevels = False\r\nnwcOpt.Coordinates = 0#NavisworksCoordinates.Internal\r\nnwcOpt.ExportElementIds = True\r\nnwcOpt.ExportScope = NavisworksExportScope.View\r\nnwcOpt.ViewId = doc.ActiveView.Id\r\n\r\n\r\n#doc.Export(path, \"Test.nwc\", nwcOpt)\r\n\r\n#OUT = \"Exported sucessfully\" if result else \"Not Exported\"\r\n\r\n\r\nOUT = nwcOpt",
