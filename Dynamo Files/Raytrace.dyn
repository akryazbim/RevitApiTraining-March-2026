      "Code": "import clr\r\n\r\nimport sys\r\nsys.path.append('C:\\Program Files (x86)\\IronPython 2.7\\Lib')\r\n\r\nimport System\r\nfrom System.Collections.Generic import *\r\n\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager \r\nfrom RevitServices.Transactions import TransactionManager \r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitAPIUI\")\r\n\r\nimport Autodesk \r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nfrom Autodesk.Revit.UI import *\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication \r\napp = uiapp.Application \r\nuidoc = uiapp.ActiveUIDocument\r\n\r\ndef tolist(obj1):\r\n\tif isinstance(obj1,(list, tuple, set)): return obj1\r\n\telse: return [obj1]\r\n\r\n#Preparing input from dynamo to revit\r\ndl = UnwrapElement(IN[0])\r\n\r\n#Do some action in a Transaction\r\n\r\nview3Ds = FilteredElementCollector(doc).OfClass(View3D).ToElements()\r\nsundarView = [i for i in view3Ds if i.Name == \"Sundar\"][0]\r\n\r\ncatFilter = ElementCategoryFilter(BuiltInCategory.OST_Ceilings)\r\n\r\nri = ReferenceIntersector(catFilter, FindReferenceTarget.Element, sundarView)\r\n\r\nloc = dl.Location.Curve\r\norigin = loc.Center\r\n\r\ndir = XYZ(0,0,1)\r\n\r\nrwc = ri.FindNearest(origin, dir)\r\nrefer = rwc.GetReference()\r\nele = doc.GetElement(refer)\r\ndist = rwc.Proximity*304.8\r\npt = refer.GlobalPoint\r\n\r\n\r\n\"\"\"\r\npublic FamilyInstance NewFamilyInstance(\r\n    XYZ location,\r\n    FamilySymbol symbol,\r\n    Element host,\r\n    Level level,\r\n    StructuralType structuralType\r\n)\"\"\"\r\n\r\n\r\nfs = FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_LightingFixtures).WhereElementIsElementType().FirstElement()\r\n\r\nlevel = doc.GetElement(ele.LevelId)\r\n\r\n\r\n\r\n\r\n\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n\r\nnewFixture = doc.Create.NewFamilyInstance(pt, fs, ele, level, StructuralType.NonStructural)\r\n\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = newFixture",
