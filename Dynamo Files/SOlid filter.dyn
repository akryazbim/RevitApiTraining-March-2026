  "Name": "SOlid filter",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nimport sys\r\nsys.path.append('C:\\Program Files (x86)\\IronPython 2.7\\Lib')\r\n\r\nimport System\r\nfrom System.Collections.Generic import *\r\n\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager \r\nfrom RevitServices.Transactions import TransactionManager \r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitAPIUI\")\r\n\r\nimport Autodesk \r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Mechanical import *\r\nfrom Autodesk.Revit.UI import *\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication \r\napp = uiapp.Application \r\nuidoc = uiapp.ActiveUIDocument\r\n\r\ndef tolist(obj1):\r\n\tif isinstance(obj1,(list, tuple, set)): return obj1\r\n\telse: return [obj1]\r\n\r\n#Preparing input from dynamo to revit\r\nwalls = tolist(UnwrapElement(IN[0]))\r\n\r\n#Do some action in a Transaction\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nrvtLinks = FilteredElementCollector(doc).OfClass(RevitLinkInstance).ToElements()\r\n\r\nfor rvtLink in rvtLinks:\r\n    if \"MEP Model\" in rvtLink.Name:\r\n        linkFile = rvtLink\r\n        break\r\n\r\nlinkDoc = linkFile.GetLinkDocument()\r\n\r\nlinkDucts = FilteredElementCollector(linkDoc).OfClass(Duct).ToElements()\r\n\r\nparamValues = []\r\n\r\nfor linkDuct in linkDucts:\r\n    commentParam = linkDuct.LookupParameter(\"Comments\")\r\n    value = commentParam.AsString()\r\n    #commentParam.Set(\"Test\")\r\n    paramValues.append(value)   \r\n    \r\n\r\nresults = []\r\n\r\nvfts = FilteredElementCollector(doc).OfClass(ViewFamilyType).ToElements()\r\n\r\nfor vft in vfts:\r\n    if vft.LookupParameter(\"Type Name\").AsString() == \"3D View\":\r\n        threeDType = vft\r\n        break\r\n\r\n\r\nfor wall in walls:\r\n    bb = wall.get_BoundingBox(None)\r\n    bbFilter = BoundingBoxIntersectsFilter(Outline(bb.Min, bb.Max))\r\n    geos = wall.get_Geometry(Options())\r\n    solid = list(geos)[0]\r\n    solidFilter = ElementIntersectsSolidFilter(solid)\r\n    clashes = FilteredElementCollector(linkDoc).OfClass(Duct).WherePasses(bbFilter).WherePasses(solidFilter).ToElements()\r\n    \r\n    coll = List[ElementId]()\r\n    coll.Add(linkFile.Id)\r\n    coll.Add(wall.Id)\r\n\r\n    newView = View3D.CreateIsometric(doc, threeDType.Id)\r\n    newView.Name = str(wall.Id.Value)\r\n    newView.SetSectionBox(bb)\r\n    \r\n    newView.IsolateElementsTemporary(coll)\r\n    \r\n    results.append([wall, clashes])\r\n\r\n\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = threeDType",
      "Engine": "CPython3",
      "VariableInputPorts": true,
