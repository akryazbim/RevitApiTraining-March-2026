    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nimport sys\r\nsys.path.append('C:\\Program Files (x86)\\IronPython 2.7\\Lib')\r\n\r\nimport System\r\nfrom System.Collections.Generic import *\r\n\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager \r\nfrom RevitServices.Transactions import TransactionManager \r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitAPIUI\")\r\n\r\nimport Autodesk \r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.UI import *\r\nfrom Autodesk.Revit.UI.Selection import *\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication \r\napp = uiapp.Application \r\nuidoc = uiapp.ActiveUIDocument\r\n\r\ndef tolist(obj1):\r\n\tif isinstance(obj1,(list, tuple, set)): return obj1\r\n\telse: return [obj1]\r\n\r\n#Preparing input from dynamo to revit\r\nelement = UnwrapElement(IN[0])\r\n\r\n#Do some action in a Transaction\r\n\r\nselectedIds = uidoc.Selection.GetElementIds()\r\n\r\n\"\"\"\r\nresult = []\r\n\r\nfor selectedId in selectedIds:\r\n    ele = doc.GetElement(selectedId)\r\n    result.append(ele.Name)\r\n\"\"\"\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\"\"\"public void SetElementIds(\r\n    ICollection<ElementId> elementIds\r\n)\"\"\"\r\n\r\n\r\nwalls = FilteredElementCollector(doc).OfClass(Wall).ToElements()\r\n\r\nids = List[ElementId]()\r\n\r\nfor wall in walls:\r\n    id = wall.Id\r\n    ids.Add(id)\r\n    \r\n\r\n#uidoc.Selection.SetElementIds(ids)\r\n\r\n\"\"\"\r\nTaskDialog.Show(\"Prompt\", \"Now select elements in Revit screen\")\r\nslectedIds = uidoc.Selection.PickElementsByRectangle(\"Pick Elements - User Hint\")\r\nTaskDialog.Show(\"Prompt\", \"Selection over\")\r\n\"\"\"\r\n\r\n\"\"\"\r\nselectedRefs = uidoc.Selection.PickObjects(ObjectType.Element)\r\neles = []\r\nfor i in selectedRefs:\r\n    ele = doc.GetElement(i.ElementId)\r\n    eles.append(ele)\r\n    \r\n\r\n#eles = [doc.GetElement(i.ElementId) for i in eles]\r\n\r\n\"\"\"\r\n\r\n#linkiedEle = uidoc.Selection.PickObject(ObjectType.LinkedElement)\r\n\r\n\r\nclass CustomFilter(ISelectionFilter):\r\n    def __init__(self):\r\n        super(CustomFilter, self).__init__()\r\n\r\n    def AllowElement(self, element):\r\n        try:\r\n            return element.Category.Name == \"Walls\"\r\n        except:\r\n            return False\r\n\r\n    def AllowReference(self, reference, point):\r\n        return False\r\n\r\n#filt = CustomFilter()\r\n\r\n\r\n\r\n#selectedElements = uidoc.Selection.PickElementsByRectangle(filt)\r\n\r\n\r\n\r\n\r\n\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = selectedElements\r\n",
