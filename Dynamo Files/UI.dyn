    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# .NET references\r\nclr.AddReference('System.Windows.Forms')\r\nclr.AddReference('System.Drawing')\r\n\r\nfrom System.Windows.Forms import Form, Label, TextBox, NumericUpDown, TrackBar, CheckBox, Button, DialogResult\r\nfrom System.Drawing import Point, Size\r\nfrom System import Decimal\r\n\r\nclass SimpleForm(Form):\r\n    def __init__(self):\r\n        self.Text = \"User Input Form\"\r\n        self.Size = Size(800, 800)\r\n\r\n        # Name\r\n        self.labelName = Label()\r\n        self.labelName.Text = \"Name:\"\r\n        self.labelName.Location = Point(100, 20)\r\n\r\n        self.textName = TextBox()\r\n        self.textName.Location = Point(500, 20)\r\n        self.textName.Width = 150\r\n\r\n        # Age (NumericUpDown requires Decimal)\r\n        self.labelAge = Label()\r\n        self.labelAge.Text = \"Age:\"\r\n        self.labelAge.Location = Point(10, 60)\r\n\r\n        self.numAge = NumericUpDown()\r\n        self.numAge.Location = Point(120, 60)\r\n        self.numAge.Width = 60\r\n        self.numAge.Minimum = Decimal(0)\r\n        self.numAge.Maximum = Decimal(120)\r\n        self.numAge.Value = Decimal(25)\r\n\r\n        # Experience (Slider)\r\n        self.labelExp = Label()\r\n        self.labelExp.Text = \"Experience:\"\r\n        self.labelExp.Location = Point(10, 100)\r\n\r\n        self.sliderExp = TrackBar()\r\n        self.sliderExp.Location = Point(120, 90)\r\n        self.sliderExp.Width = 150\r\n        self.sliderExp.Minimum = 0\r\n        self.sliderExp.Maximum = 40\r\n        self.sliderExp.TickFrequency = 5\r\n        self.sliderExp.Value = 5\r\n\r\n        # Married checkbox\r\n        self.checkMarried = CheckBox()\r\n        self.checkMarried.Text = \"Married\"\r\n        self.checkMarried.Location = Point(120, 140)\r\n\r\n        # Submit Button\r\n        self.buttonSubmit = Button()\r\n        self.buttonSubmit.Text = \"Submit\"\r\n        self.buttonSubmit.Location = Point(100, 200)\r\n        self.buttonSubmit.Click += self.on_submit\r\n\r\n        # Add controls\r\n        self.Controls.Add(self.labelName)\r\n        self.Controls.Add(self.textName)\r\n        self.Controls.Add(self.labelAge)\r\n        self.Controls.Add(self.numAge)\r\n        self.Controls.Add(self.labelExp)\r\n        self.Controls.Add(self.sliderExp)\r\n        self.Controls.Add(self.checkMarried)\r\n        self.Controls.Add(self.buttonSubmit)\r\n\r\n        self.result = None\r\n\r\n    def on_submit(self, sender, args):\r\n        self.result = {\r\n            \"Name\": self.textName.Text,\r\n            \"Age\": int(self.numAge.Value),  # convert Decimal → int safely\r\n            \"Experience\": self.sliderExp.Value,\r\n            \"Married\": self.checkMarried.Checked\r\n        }\r\n        self.DialogResult = DialogResult.OK\r\n        self.Close()\r\n\r\n# Run form (modal)\r\nform = SimpleForm()\r\nform.ShowDialog()\r\n\r\nOUT = form.result",
