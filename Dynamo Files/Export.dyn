      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nimport sys\r\nsys.path.append('C:\\Program Files (x86)\\IronPython 2.7\\Lib')\r\n\r\nimport System\r\nfrom System.Collections.Generic import *\r\n\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager \r\nfrom RevitServices.Transactions import TransactionManager \r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitAPIUI\")\r\n\r\nimport Autodesk \r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.UI import *\r\n\r\nimport os\r\nfrom pathlib import Path\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication \r\napp = uiapp.Application \r\nuidoc = uiapp.ActiveUIDocument\r\n\r\ndef tolist(obj1):\r\n\tif isinstance(obj1,(list, tuple, set)): return obj1\r\n\telse: return [obj1]\r\n\r\n#Preparing input from dynamo to revit\r\nelement = UnwrapElement(IN[0])\r\n\r\n#Do some action in a Transaction\r\n\r\n\"\"\"\r\npublic void Export(\r\n    string folder,\r\n    string name,\r\n    NavisworksExportOptions options\r\n)\r\n\"\"\"\r\nnwcOpt = NavisworksExportOptions()\r\nnwcOpt.ConvertElementProperties = True\r\nnwcOpt.ConvertLights = True\r\nnwcOpt.ConvertLinkedCADFormats = False\r\nnwcOpt.Coordinates = 0#NavisworksCoordinates.Internal\r\nnwcOpt.DivideFileIntoLevels = False\r\nnwcOpt.ExportElementIds = True\r\nnwcOpt.ExportScope = NavisworksExportScope.View\r\n#nwcOpt.ViewId = \r\n\r\n\"\"\"\r\npublic bool Export(\r\n    string folder,\r\n    string name,\r\n    ICollection<ElementId> views,\r\n    DWGExportOptions options\r\n)\"\"\"\r\n\r\n\r\ndwgOpt = DWGExportOptions()\r\ndwgOpt.MergedViews = True\r\n\r\npath = r\"C:\\Users\\Akryazz\\OneDrive\\Documents\\My Files\\Revit Api Training\\Python Revit API Training\\Working Files\\RevitApiTraining-March-2026\\Exports\"\r\n\r\n\r\nsheet = FilteredElementCollector(doc).OfClass(ViewSheet).FirstElement()\r\n\r\n#doc.Title+\"_\"+sheet.Name+\".dwg\"\r\nfileName = f\"{doc.Title}_{sheet.Name}.dwg\"\r\n\r\nsheetList = List[ElementId]()\r\nsheetList.Add(sheet.Id)\r\n\r\nfrom datetime import date\r\n\r\ntoday = date.today()\r\n\r\nfolderPath = r\"C:\\Users\\Akryazz\\OneDrive\\Documents\\My Files\\Revit Api Training\\Python Revit API Training\\Working Files\\RevitApiTraining-March-2026\\Exports\\Ishaque-\"+str(today)\r\n\r\nPath(folderPath).mkdir(parents=True, exist_ok=True)\r\n\r\n#doc.Export(folderPath, fileName, sheetList, dwgOpt)\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = OptionalFunctionalityUtils.IsNavisworksExporterAvailable()",
